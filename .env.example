# OpenSRS Reseller API
OPENSRS_API_USER=your_reseller_username
OPENSRS_API_KEY=your_api_key
OPENSRS_API_URL=https://admin.hostedemail.com/api

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_EMAIL_PRICE_ID=price_...

# Personal Mail Server (Mailcow)
MAILCOW_HOSTNAME=mail.yourdomain.com
MAILCOW_TIMEZONE=America/New_York

# Gmail SMTP Relay (optional)
GMAIL_RELAY_ENABLED=false
GMAIL_RELAY_HOST=smtp-relay.gmail.com
GMAIL_RELAY_PORT=587
