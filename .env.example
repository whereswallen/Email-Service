# ===================================================================
# Domain & Email Platform Configuration
# ===================================================================

# --- Provider Selection ---
EMAIL_PROVIDER=opensrs                      # 'opensrs' or 'mailcow'
REGISTRAR_PROVIDER=opensrs                  # 'opensrs' (more registrars via abstraction later)

# --- OpenSRS Email API ---
OPENSRS_API_USER=your_reseller_username
OPENSRS_API_KEY=your_api_key
OPENSRS_API_URL=https://admin.hostedemail.com/api

# --- OpenSRS Domain Registration API ---
# Uses same credentials as email (same reseller account)
OPENSRS_REGISTRAR_URL=https://rr-n1-tor.opensrs.net:55443

# --- Mailcow Reselling (when EMAIL_PROVIDER=mailcow) ---
MAILCOW_API_URL=https://mail.yourbrand.com
MAILCOW_API_KEY=your-read-write-api-key

# --- Personal Mail Server (Mailcow) ---
MAILCOW_HOSTNAME=mail.yourdomain.com
MAILCOW_TIMEZONE=America/New_York

# --- Stripe Billing ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_EMAIL_PRICE_ID=price_...
STRIPE_DOMAIN_PRICE_ID=price_...

# --- Database ---
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://platform:your_secure_password@localhost:5432/domain_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API Server ---
PORT=3000
HOST=0.0.0.0
JWT_SECRET=your_jwt_secret_here

# --- Anthropic AI ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001

# --- Gmail SMTP Relay (optional, for Mailcow IP warming) ---
GMAIL_RELAY_ENABLED=false
GMAIL_RELAY_HOST=smtp-relay.gmail.com
GMAIL_RELAY_PORT=587
