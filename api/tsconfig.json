{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@sdk/*": ["../sdk/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "../sdk/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
